# MechLab API Keys
# Get keys from: https://openrouter.ai/keys

# Primary API Key
OPENROUTER_API_KEY=your_primary_key_here

# Secondary API Key (Optional, for safety/redundancy)
OPENROUTER_API_KEY_2=your_secondary_key_here

# Optional: Google Gemini API Key
# GOOGLE_API_KEY=your_gemini_key_here

# Server Port
PORT=5000
